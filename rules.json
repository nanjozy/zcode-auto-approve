{
  "version": 2,
  "engine": "model",
  "activePolicy": "standard",

  "policies": {
    "strict": {
      "description": "只放行明确只读语义的命令",
      "maxRiskLevel": "low"
    },
    "standard": {
      "description": "只读 + 常规开发操作（默认）",
      "maxRiskLevel": "medium"
    }
  },

  "judge": {
    "model": "GLM-5.3-Flash",
    "maxTokens": 512,
    "temperature": 0,
    "attempts": 4,
    "perAttemptTimeoutMs": 15000,
    "overallDeadlineMs": 25000,
    "retryBackoffMs": 500,

    "cache": {
      "enabled": true,
      "ttlMs": 86400000,
      "maxEntries": 500
    }
  },

  "deny": {
    "patterns": [
      "rm\\s+(-[a-z]*r[a-z]*f|-[a-z]*f[a-z]*r)",
      "rm\\s+.*(/|~)\\s*$",
      "\\bsudo\\b",
      "\\bsu\\b",
      "curl[^|]*\\|\\s*(ba|z)?sh",
      "wget[^|]*\\|\\s*(ba|z)?sh",
      "(^|[;&|()]\\s*)eval\\b",
      "\\bbase64\\s+(-d|-D|--decode)\\b",
      "reg\\s+(add|delete|import)",
      "Set-ExecutionPolicy",
      "schtasks|sc\\s+(config|delete)|netsh",
      "chkdsk|format\\s+[a-z]:|diskpart",
      "git\\s+push\\b.*(\\s--force\\b|\\s-f\\b)",
      ">\\s*/dev/sd",
      "dd\\b.*of=/dev/"
    ],
    "tools": ["mcp__.*", "WebFetch", "WebSearch", "Agent", "SendMessage"]
  },

  "tools": ["Read", "Glob", "Grep", "TodoRead", "TodoWrite", "Task"],

  "fileEdits": { "pathPolicy": "workspace-only" },

  "guards": {
    "disabledWorkspaces": []
  }
}
